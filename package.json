{
  "name": "dzgraph-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1",
    "test:tz": "TZ=Pacific/Auckland vitest run --maxWorkers=2 && TZ=America/Los_Angeles vitest run --maxWorkers=2",
    "test:browsers": "BROWSERS=all vitest run --project browser --project angular",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/dom/tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit && ngc -p packages/angular/tsconfig.spec.json --noEmit",
    "build": "node scripts/build.mjs",
    "check:size": "node scripts/size.mjs",
    "gate:step": "npm run test:ci && npm run test:tz && npm run typecheck && npm run build && npm run check:size",
    "spike": "node spikes/all.mjs",
    "build:theme": "node scripts/build-theme.mjs",
    "playground": "node scripts/playground.mjs",
    "test:reference": "node scripts/browser-reference.mjs",
    "bench": "node scripts/bench.mjs",
    "check:angular": "node scripts/angular-compat.mjs"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/build": "^21.2.30",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^4.1.12",
    "esbuild": "^0.25.12",
    "fast-check": "^4.10.3",
    "ng-packagr": "^21.2.7",
    "playwright": "^1.65.1",
    "playwright-core": "^1.65.1",
    "rxjs": "~7.8.0",
    "sass": "^1.105.2",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}

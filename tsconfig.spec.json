{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@dzgraph/core": ["./packages/core/src/index.ts"],
      "@dzgraph/core/internal": ["./packages/core/src/internal.ts"],
      "@dzgraph/dom": ["./packages/dom/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
